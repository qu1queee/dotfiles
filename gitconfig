[user]
	name = Enrique Encalada
	email = encaladaenrique@gmail.com

[core]
	editor = code --wait
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[init]
	defaultBranch = main

[push]
	default = current

[pull]
	rebase = false

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = green
	changed = yellow
	untracked = cyan

[alias]
	st = status
	ci = commit
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all
	ign = ls-files -o -i --exclude-standard
	shoot = push origin --delete
	unstage = reset HEAD --
	prev = checkout -

# Per-machine overrides (identity, remote rewrites). Not tracked in this repo.
[include]
	path = ~/.config/git/local
